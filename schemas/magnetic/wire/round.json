{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://psma.com/mas/magnetic/wire/round.json",
    "$comment": "SPDX-License-Identifier: Apache-2.0",
    "$ref": "./basicWire.json",
    "title": "wire/round",
    "description": "The description of a solid round magnet wire",
    "type": "object",
    "properties": {
        "type": {
            "const": "round",
            "$comment": "Discriminator pin: this file matches ONLY its own wire type (the union is a real oneOf)."
        },
        "material": {
            "title": "WireMaterialDataOrNameUnion",
            "oneOf": [
                {
                    "$ref": "./material.json"
                },
                {
                    "description": "The name of the material used in the wire",
                    "type": "string"
                }
            ]
        },
        "conductingDiameter": {
            "description": "The conducting diameter of the wire, in m",
            "$ref": "../../utils.json#/$defs/dimensionWithTolerance"
        },
        "outerDiameter": {
            "description": "The outer diameter of the wire, in m",
            "$ref": "../../utils.json#/$defs/dimensionWithTolerance"
        }
    },
    "required": [
        "type",
        "conductingDiameter"
    ],
    "$defs": {},
    "unevaluatedProperties": false
}
