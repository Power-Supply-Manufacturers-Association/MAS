{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://psma.com/mas/magnetic/wire/material.json",
    "$comment": "SPDX-License-Identifier: Apache-2.0",
    "title": "wire/material",
    "description": "A material for wire",
    "type": "object",
    "properties": {
        "name": {
            "description": "The name of a wire material",
            "type": "string"
        },
        "permeability": {
            "description": "The permeability of a wire material",
            "type": "number",
            "exclusiveMinimum": 0
        },
        "resistivity": {
            "$ref": "#/$defs/resistivity"
        },
        "thermalConductivity": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/thermalConductivityPoint"
            },
            "minItems": 1
        },
        "density": {
            "description": "Density of the conductor material, in kg/m3.",
            "type": "number",
            "exclusiveMinimum": 0
        },
        "provenance": {
            "description": "Where this record's values come from, per field: the document, its URL and retrieval date, and how far the values were checked against it. Optional; a value without an entry here has no stated source.",
            "$ref": "../../utils.json#/$defs/provenance"
        }
    },
    "required": [
        "name",
        "permeability",
        "resistivity"
    ],
    "$defs": {
        "resistivity": {
            "description": "data for describing the resistivity of a wire",
            "type": "object",
            "properties": {
                "referenceValue": {
                    "description": "Resistivity reference value, in Ohm * m",
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "referenceTemperature": {
                    "description": "Temperature reference value, in Celsius",
                    "type": "number"
                },
                "temperatureCoefficient": {
                    "description": "Temperature coefficient value, alpha, in 1 / Celsius",
                    "type": "number"
                }
            },
            "required": [
                "referenceValue",
                "referenceTemperature",
                "temperatureCoefficient"
            ],
            "additionalProperties": false
        },
        "thermalConductivityPoint": {
            "description": "data for describing one point of thermal conductivity",
            "type": "object",
            "properties": {
                "value": {
                    "description": "Thermal conductivity value. Unit: W/(m*K).",
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "temperature": {
                    "description": "Temperature for the field value, in Celsius.",
                    "type": "number"
                }
            },
            "required": [
                "value",
                "temperature"
            ],
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
