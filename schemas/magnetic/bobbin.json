{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://psma.com/mas/magnetic/bobbin.json",
    "$comment": "SPDX-License-Identifier: Apache-2.0",
    "title": "bobbin",
    "description": "Description of a bobbin (the insulating former on which one or more windings are arranged). The term is industry-conventional; an IEV entry is being proposed by PSMA. See docs/normative-references.md.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "name": {
            "description": "Name of the bobbin.",
            "type": "string"
        },
        "manufacturerInfo": {
            "$ref": "https://psma.com/peas/utils.json#/$defs/manufacturerInfo"
        },
        "distributorsInfo": {
            "description": "List of distributors of this bobbin.",
            "type": "array",
            "items": {
                "$ref": "https://psma.com/peas/utils.json#/$defs/distributorInfo"
            },
            "uniqueItems": false
        },
        "functionalDescription": {
            "description": "Bobbin data described in functional terms, in a form suitable for analytical models.",
            "type": "object",
            "title": "bobbinFunctionalDescription",
            "properties": {
                "type": {
                    "description": "Whether the bobbin is a standard catalogue part or a custom design.",
                    "type": "string",
                    "enum": [
                        "standard",
                        "custom"
                    ]
                },
                "family": {
                    "description": "Bobbin family, named after the core shape family it is intended to fit. See IEC 62317 / IEC 63093.",
                    "title": "bobbinFamily",
                    "type": "string",
                    "enum": [
                        "u",
                        "e",
                        "etd",
                        "er",
                        "p",
                        "rm",
                        "ep",
                        "pm",
                        "el",
                        "pq",
                        "efd",
                        "ec",
                        "t"
                    ]
                },
                "shape": {
                    "description": "Name of the core shape this bobbin is matched to.",
                    "type": "string"
                },
                "familySubtype": {
                    "description": "Subtype of the shape, where more than one variant exists in the family.",
                    "type": "string"
                },
                "material": {
                    "oneOf": [
                        {
                            "$ref": "./insulation/material.json"
                        },
                        {
                            "description": "Name of the material used in the bobbin.",
                            "type": "string"
                        }
                    ]
                },
                "dimensions": {
                    "description": "Bobbin dimensions. Keys are the dimension labels defined in IEC 62317 / IEC 63093 for the parent core shape.",
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "../utils.json#/$defs/dimension"
                    }
                },
                "pinout": {
                    "$ref": "#/$defs/pinout"
                },
                "orientation": {
                    "description": "Mounting orientation of the bobbin",
                    "type": "string",
                    "enum": [
                        "horizontal",
                        "vertical"
                    ]
                },
                "variant": {
                    "description": "Variant name of the bobbin (e.g. flanged, foot-print)",
                    "type": "string"
                },
                "numberChambers": {
                    "description": "Number of winding chambers the former is divided into by interior dividers; 1 (or absent) is a plain two-flange former.",
                    "type": "integer",
                    "minimum": 1
                },
                "base": {
                    "description": "Mounting base of the bobbin, the mechanical body that carries the wound part and its pins. Only meaningful for family t, where the base plays the former's role for a toroid.",
                    "title": "bobbinBase",
                    "type": "object",
                    "properties": {
                        "mounting": {
                            "description": "How the wound part sits on the base: horizontal lays the ring flat in a pocket, vertical stands it on edge in a boat.",
                            "type": "string",
                            "enum": [
                                "horizontal",
                                "vertical"
                            ]
                        },
                        "length": {
                            "description": "Overall length of the base, along the longer side of its footprint. Unit: m.",
                            "$ref": "../utils.json#/$defs/dimensionWithTolerance"
                        },
                        "width": {
                            "description": "Overall width of the base, across its footprint. Unit: m.",
                            "$ref": "../utils.json#/$defs/dimensionWithTolerance"
                        },
                        "height": {
                            "description": "Overall height of the base, from the seating plane to its top face. Unit: m.",
                            "$ref": "../utils.json#/$defs/dimensionWithTolerance"
                        },
                        "standoff": {
                            "description": "Distance the base holds the wound part above the mounting surface. Unit: m.",
                            "$ref": "../utils.json#/$defs/dimensionWithTolerance"
                        },
                        "pocketInnerDiameter": {
                            "description": "Inner diameter of the pocket that receives the wound ring, for a horizontal base. Unit: m.",
                            "$ref": "../utils.json#/$defs/dimensionWithTolerance"
                        },
                        "pocketDepth": {
                            "description": "Depth of the pocket that receives the wound ring, for a horizontal base. Unit: m.",
                            "$ref": "../utils.json#/$defs/dimensionWithTolerance"
                        },
                        "boatWidth": {
                            "description": "Width of the slot that holds the wound ring on edge, for a vertical base. Unit: m.",
                            "$ref": "../utils.json#/$defs/dimensionWithTolerance"
                        },
                        "maximumCoreOuterDiameter": {
                            "description": "Largest wound-core outer diameter the base accepts. Unit: m.",
                            "type": "number"
                        },
                        "maximumCoreHeight": {
                            "description": "Largest wound-core height the base accepts. Unit: m.",
                            "type": "number"
                        }
                    },
                    "required": [
                        "mounting",
                        "length",
                        "width",
                        "height",
                        "standoff"
                    ],
                    "additionalProperties": false
                },
                "connections": {
                    "description": "List of connections between windings and pins",
                    "type": "array",
                    "items": {
                        "title": "pinWindingConnection",
                        "type": "object",
                        "properties": {
                            "pin": {
                                "description": "The name of the connected pin",
                                "type": "string"
                            },
                            "winding": {
                                "description": "The name of the connected winding",
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    },
                    "minItems": 0,
                    "uniqueItems": true
                }
            },
            "required": [
                "type",
                "family",
                "shape",
                "dimensions"
            ],
            "additionalProperties": false
        },
        "processedDescription": {
            "type": "object",
            "title": "coreBobbinProcessedDescription",
            "properties": {
                "wallThickness": {
                    "description": "The thickness of the walls that hold the wire on both sides of the column",
                    "type": "number",
                    "minimum": 0
                },
                "columnThickness": {
                    "description": "The thickness of the central column wall, where the wire is wound, in the X axis",
                    "type": "number",
                    "minimum": 0
                },
                "columnDepth": {
                    "description": "The depth of the central column wall, including thickness, in the z axis",
                    "type": "number",
                    "minimum": 0
                },
                "columnWidth": {
                    "description": "The width of the central column wall, including thickness, in the x axis",
                    "type": "number",
                    "minimum": 0
                },
                "columnShape": {
                    "$ref": "../utils.json#/$defs/columnShape"
                },
                "columnCornerRadius": {
                    "description": "Radius of the corners of the central column, where the wire bends around it while being wound. Only meaningful for rectangular and irregular columns: for a round column the radius is columnWidth, and for an oblong one it is columnDepth / 2. Moulded bobbins always have a finite corner radius; a wire whose minimum bend radius exceeds this one cannot follow the corner and lifts off the flat faces instead",
                    "type": "number",
                    "minimum": 0
                },
                "windingWindows": {
                    "description": "List of winding windows, all elements in the list must be of the same type",
                    "title": "windingWindows",
                    "oneOf": [
                        {
                            "description": "List of rectangular winding windows",
                            "type": "array",
                            "items": {
                                "$ref": "./core.json#/$defs/rectangularWindingWindow"
                            },
                            "minItems": 1,
                            "uniqueItems": false
                        },
                        {
                            "description": "List of radial winding windows",
                            "type": "array",
                            "items": {
                                "$ref": "./core.json#/$defs/radialWindingWindow"
                            },
                            "minItems": 1,
                            "uniqueItems": false
                        }
                    ]
                },
                "pins": {
                    "description": "List of pins, geometrically defining how and where it is",
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/pin"
                    },
                    "minItems": 0,
                    "uniqueItems": true
                },
                "dividers": {
                    "description": "Interior walls that split the winding area into chambers, in the order they appear along the column.",
                    "type": "array",
                    "items": {
                        "title": "bobbinDivider",
                        "description": "One interior wall of a multi-chamber former.",
                        "type": "object",
                        "properties": {
                            "thickness": {
                                "description": "Thickness of the divider wall, measured along the column axis. Unit: m.",
                                "type": "number",
                                "exclusiveMinimum": 0
                            },
                            "coordinates": {
                                "description": "The coordinates of the centre of the divider, referred to the centre of the main column.",
                                "$ref": "../utils.json#/$defs/coordinates"
                            },
                            "height": {
                                "description": "Radial reach of the divider from the column surface outwards; absent means it reaches as far as the flanges. Unit: m.",
                                "type": "number"
                            },
                            "crossingSlot": {
                                "description": "Notch cut in the divider through which a wire crosses from one chamber to the next.",
                                "title": "dividerCrossingSlot",
                                "type": "object",
                                "properties": {
                                    "width": {
                                        "description": "Width of the slot, measured along the divider rim. Unit: m.",
                                        "type": "number"
                                    },
                                    "depth": {
                                        "description": "Depth of the slot, measured radially inwards from the divider rim. Unit: m.",
                                        "type": "number"
                                    },
                                    "angle": {
                                        "description": "Angular position of the slot around the column, from the positive x axis. Unit: degree.",
                                        "type": "number"
                                    }
                                },
                                "additionalProperties": false
                            }
                        },
                        "required": [
                            "thickness",
                            "coordinates"
                        ],
                        "additionalProperties": false
                    },
                    "minItems": 0
                },
                "coordinates": {
                    "description": "The coordinates of the center of the bobbin central wall, where the wires are wound, referred to the center of the main column.",
                    "$ref": "../utils.json#/$defs/coordinates"
                }
            },
            "required": [
                "columnShape",
                "wallThickness",
                "columnThickness",
                "columnDepth",
                "windingWindows"
            ],
            "additionalProperties": false
        }
    },
    "anyOf": [
        {
            "required": [
                "functionalDescription"
            ]
        },
        {
            "required": [
                "processedDescription"
            ]
        }
    ],
    "$defs": {
        "pin": {
            "description": "Data describing one pin in a bobbin",
            "title": "pin",
            "type": "object",
            "properties": {
                "name": {
                    "description": "Name given to the pin",
                    "type": "string"
                },
                "shape": {
                    "description": "The shape of the pin",
                    "title": "pinShape",
                    "type": "string",
                    "enum": [
                        "round",
                        "rectangular",
                        "irregular"
                    ]
                },
                "type": {
                    "description": "Type of pin",
                    "type": "string",
                    "enum": [
                        "smd",
                        "tht"
                    ]
                },
                "rotation": {
                    "description": "The rotation of the pin, default is vertical",
                    "$ref": "../utils.json#/$defs/rotation"
                },
                "dimensions": {
                    "description": "Dimensions of the rectangle defining the pin",
                    "$ref": "../utils.json#/$defs/dimensions"
                },
                "coordinates": {
                    "description": "The coordinates of the center of the pin, referred to the center of the main column",
                    "$ref": "../utils.json#/$defs/coordinates"
                },
                "removable": {
                    "description": "Whether the pin may be cut off or omitted by the winder to open up creepage, as bobbin makers offer for corner pins.",
                    "type": "boolean",
                    "default": false
                }
            },
            "required": [
                "shape",
                "type",
                "dimensions"
            ],
            "additionalProperties": false
        },
        "pinout": {
            "description": "Data describing the pinout of a bobbin",
            "title": "pinout",
            "type": "object",
            "properties": {
                "pitch": {
                    "oneOf": [
                        {
                            "description": "The distance between pins, per row, by pin order",
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        {
                            "description": "The distance between pins, common for all pins",
                            "type": "number"
                        }
                    ]
                },
                "centralPitch": {
                    "description": "The distance between central pins",
                    "type": "number"
                },
                "rowDistance": {
                    "description": "The distance between a row of pins and the center of the bobbin",
                    "type": "number"
                },
                "numberRows": {
                    "description": "The number of rows of a bobbin, typically 2",
                    "type": "integer",
                    "default": 2
                },
                "numberPins": {
                    "description": "The number of pins",
                    "type": "integer"
                },
                "numberPinsPerRow": {
                    "description": "List of pins per row",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "pinDescription": {
                    "$ref": "#/$defs/pin"
                }
            },
            "required": [
                "numberPins"
            ],
            "additionalProperties": false
        }
    }
}
